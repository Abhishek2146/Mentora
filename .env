# ============================================================
# Project Environment Variables
# Copy to .env.local and update values for local development
# ============================================================

# Application
APP_NAME=Mentora AI Learning Companion
ENVIRONMENT=development
DEBUG=True

# Backend (FastAPI)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=True
API_VERSION=v1
API_PREFIX=/api/v1

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Mentora

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://mentora:mentora123@localhost:5432/mentora
DB_ECHO=False

# Redis (for caching and session management)
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
SECRET_KEY=supersecretkeychangeinproduction
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
JWT_REFRESH_EXPIRE_MINUTES=10080

# AI Services
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Vector Database (ChromaDB)
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIR=./chromadb

# File Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=52428800
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,gif,mp3,wav

# Email (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Voice Recognition
WHISPER_MODEL_SIZE=base
TTS_ENGINE=pyttsx3

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
ALLOWED_METHODS=*
ALLOWED_HEADERS=*

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60
