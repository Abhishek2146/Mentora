# Application
APP_NAME=Mentora AI Learning Companion
ENVIRONMENT=development
DEBUG=True

# API
API_PREFIX=/api/v1
API_VERSION=v1

# Backend Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=True

# Database
DATABASE_URL=postgresql+asyncpg://mentora:mentora123@postgres:5432/mentora
DB_ECHO=False

# Redis
REDIS_URL=redis://redis:6379/0

# Authentication / JWT
SECRET_KEY=supersecretkeychangeinproduction
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
JWT_REFRESH_EXPIRE_MINUTES=10080

# AI API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIR=./chromadb

# File Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=52428800
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,gif,mp3,wav

# Email / SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Voice
WHISPER_MODEL_SIZE=base
TTS_ENGINE=pyttsx3

# Khalti ePayment (NPR)
# Get live_secret_key from https://test-admin.khalti.com for sandbox, https://admin.khalti.com for prod
# Example test key: 72364e499a9949cb8cd4e6f81cc6e98f (replace with your own)
KHALTI_SECRET_KEY=
KHALTI_BASE_URL=https://dev.khalti.com/api/v2
KHALTI_WEBSITE_URL=http://localhost:5173
KHALTI_RETURN_URL=http://localhost:5173/subscription
SUBSCRIPTION_PRICE_MONTHLY_PAISE=99900
SUBSCRIPTION_PRICE_YEARLY_PAISE=999900

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:8000,http://127.0.0.1:8000
ALLOWED_METHODS=*
