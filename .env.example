# Application
APP_NAME=Mentora AI Learning Companion
ENVIRONMENT=development
DEBUG=True

# API
API_PREFIX=/api/v1
API_VERSION=v1

# Backend Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=True

# Database
DATABASE_URL=postgresql+asyncpg://mentora:mentora123@postgres:5432/mentora
DB_ECHO=False

# Redis
REDIS_URL=redis://redis:6379/0

# Authentication / JWT
SECRET_KEY=supersecretkeychangeinproduction
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
JWT_REFRESH_EXPIRE_MINUTES=10080

# AI API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIR=./chromadb

# File Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=52428800
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,gif,mp3,wav

# Email / SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Voice
WHISPER_MODEL_SIZE=base
TTS_ENGINE=pyttsx3

# CORS
ALLOWED_ORIGINS=http://localhost:5173
ALLOWED_METHODS=*
